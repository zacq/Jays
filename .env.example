# Neon: pooled connection string (host contains "-pooler"), used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon: direct (unpooled) connection string, used by migrations during the build
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Required in production
SESSION_SECRET=generate-a-long-random-string
ADMIN_PASSWORD=initial-owner-password
CRON_SECRET=generate-another-long-random-string
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# M-Pesa Daraja (optional; without these, payments fall back to manual/Till)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL=
MPESA_CALLBACK_URL=https://your-site.netlify.app/api/mpesa/callback
MPESA_CALLBACK_TOKEN=

# Africa's Talking SMS (optional)
AT_API_KEY=
AT_USERNAME=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
